# Ignore accidentally created Windows device filename
nul

# Local Claude settings
.claude/settings.local.json

# Backup / temp / scratch files (avoid re-committing clutter)
*.bak
temp_*
*_old.*

# Dependencies (npm workspaces install at the repo root)
node_modules

# Secrets: database URIs, OAuth and SMTP credentials, API keys. Never commit these;
# set them in the host's environment instead. Only the blank template is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# Build output and test artifacts
dist/
coverage/
*.tsbuildinfo

# Duel engine data, downloaded by npm run fetch-engine -w @ygo/api
api/engine-data/
api/scripts/bot-lab/prev/
api/scripts/bot-lab/prev0/
