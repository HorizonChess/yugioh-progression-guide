# Copy to api/.env (gitignored) for local development. On Render, set these in
# the service's Environment tab instead. Never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=
MONGODB_DB=ygo-progression

# Public R2 bucket that serves card art (allowed by the CSP)
IMAGE_HOST=https://pub-9397530dccf24d04a56c8eafb6e3edd0.r2.dev

PORT=4000

# Extra origins allowed to POST/PUT/DELETE, comma-separated. The server's own
# origin is always allowed; add the Next dev server when running `npm run dev`.
ALLOWED_ORIGINS=http://localhost:3000

# Google sign-in: leave blank to switch it off. Create an OAuth "Web application"
# client in Google Cloud Console with the redirect URI
#   <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The API's own public origin (defaults to http://localhost:<PORT>).
PUBLIC_URL=
# Where the browser lands after Google sign-in (defaults to PUBLIC_URL;
# set to http://localhost:3000 when using the Next dev server).
WEB_URL=

# Outgoing email for verification and password reset. With a Gmail account, make
# an app password (needs 2-Step Verification): https://myaccount.google.com/apppasswords
# Without these, no email is sent and a warning is logged.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
