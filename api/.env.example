# Copy to api/.env (gitignored) for local development. On Render, set these in
# the service's Environment tab instead. Never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=
MONGODB_DB=ygo-progression

# Public R2 bucket that serves card art (allowed by the CSP)
IMAGE_HOST=https://pub-9397530dccf24d04a56c8eafb6e3edd0.r2.dev

PORT=4000

# Extra origins allowed to POST/PUT/DELETE, comma-separated. The server's own
# origin is always allowed; add the Next dev server when running `npm run dev`.
ALLOWED_ORIGINS=http://localhost:3000
