{
  "name": "@ygo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Game server: auth, series state and server-side pack rolls, backed by MongoDB",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-cards": "tsx --env-file-if-exists=.env scripts/sync-cards.ts",
    "promote-admin": "tsx --env-file-if-exists=.env scripts/promote-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@node-rs/argon2": "^2.2.2",
    "@ygo/shared": "*",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
